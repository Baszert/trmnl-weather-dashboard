{% if error %}
<div class="layout wd-plugin layout--col p--10 flex flex--col flex--left">
  <div class="value">:(<br><br>Oops! There is an issue getting the weather data. </div>
  <div class="value--xsmall mt--4">We're on it, please wait</div>
</div>
{% else %}
<div class="layout wd-plugin layout--col rounded">

  <div class="grid grid--cols-3 h--full gap--xsmall">

    <div class="col--span-2 w--full flex flex--col gap--xsmall">

      <div class="flex flex--col flex--center-y gap--xxlarge rounded p--10 w--full h--full {{ color_mode }}
        {% if color_mode == 'light' %}
        bg--gray-75
        {% else %}
        bg--black
        {% endif %}">

        <div class="flex gap--xsmall
          {% if color_mode == 'light' %}
          text--black
          {% else %}
          text--white
          {% endif %}
          ">

          <div class="flex flex--col flex--right">
            <!-- Large number -->
            <div class="temp-display flex gap--xsmall lg:gap">

              {% assign temp_str = current_temp | append: "" %}
              {% assign temp_chars = temp_str | split: "" %}
              {% for char in temp_chars %}
              <div class="temp-digit lg:hidden" data-char="{{ char }}"></div>
              <div class="temp-digit temp-digit--large md:hidden lg:block" data-char="{{ char }}"></div>
              {% endfor %}
              <div class="temp-digit lg:hidden" data-char="°"></div>
              <div class="temp-digit temp-digit--large md:hidden lg:block" data-char="°"></div>
            </div>
          </div>

          <div class="flex flex--col flex--left gap--xsmall">

            <div class="flex gap--xsmall flex--center-x ml--1">
              <div class="flex gap--small">
                <div class="small-temp-digit lg:hidden" data-char="↑"></div>
                <div class="small-temp-digit--large md:hidden lg:block" data-char="↑"></div>
                {% assign high_str = today_max | append: "" %}
                {% assign high_chars = high_str | split: "" %}
                {% for char in high_chars %}
                <div class="small-temp-digit lg:hidden" data-char="{{ char }}"></div>
                <div class="small-temp-digit small-temp-digit--large md:hidden lg:block" data-char="{{ char }}"></div>
                {% endfor %}
                <div class="small-temp-digit lg:hidden" data-char="°"></div>
                <div class="small-temp-digit small-temp-digit--large md:hidden lg:block" data-char="°"></div>
              </div>
            </div>

            <div class="flex gap--xsmall flex--center-x ml--1">
              <div class="flex gap--small">
                <div class="small-temp-digit lg:hidden" data-char="↓"></div>
                <div class="small-temp-digit--large md:hidden lg:block" data-char="↓"></div>
                {% assign low_str = today_min | append: "" %}
                {% assign low_chars = low_str | split: "" %}
                {% for char in low_chars %}
                <div class="small-temp-digit lg:hidden" data-char="{{ char }}"></div>
                <div class="small-temp-digit small-temp-digit--large md:hidden lg:block" data-char="{{ char }}"></div>
                {% endfor %}
                <div class="small-temp-digit lg:hidden" data-char="°"></div>
                <div class="small-temp-digit small-temp-digit--large md:hidden lg:block" data-char="°"></div>
              </div>
            </div>

          </div>

        </div>

        {% assign icon_size_cls = "value lg:value--xlarge text--white" %}
        {% if color_mode == 'light' %}{% assign icon_size_cls = "value lg:value--xlarge text--black" %}{% endif %}
        {% render "wd_iconbar", code: current.weather_code, size_cls: icon_size_cls, cols_cls: "grid--cols-4", gap_cls: "gap--xlarge px--10 lg:mt--10" %}
      </div>

      <div class="p--8 w--full rounded {{ color_mode }}     
        {% if color_mode == 'light' %}
        bg--gray-75
        {% else %}
        bg--black
        {% endif %}">

        <div class="
          flex flex--row gap--large 
          {% if color_mode == 'light' %}
          text--black
          {% else %}
          text--white
          {% endif %}">

          <div class="location-name stretch value--xsmall flex flex--col flex--left gap--none">
            {{ location }}
            <span class="label--small mt--1">{{ latitude }}, {{ longitude }}</span>
          </div>

          <div class="label--small">
            LAST UPDATE<br>
            <div class="mt--2">{{ current_time }}</div>
          </div>

        </div>
      </div>

    </div>

    <div class="rounded flex flex--col py--5 px--8 gap--xlarge lg:portrait:gap--large {{ color_mode }}
      {% if color_mode == 'light' %}
      bg--gray-75
      {% else %}
      bg--black
      {% endif %}
      ">
      {% for i in (1..7) %}
      <div class="flex flex--col gap--large flex--left w--full {% if forloop.index > 3 %}md:hidden{% endif %} {% if forloop.index > 3 and forloop.index <= 5 %}lg:flex{% endif %} lg:portrait:flex">
        {% assign day_max = daily.temperature_2m_max[i] | round %}
        {% assign day_min = daily.temperature_2m_min[i] | round %}

        {% assign day_weather_code = daily.weather_code[i] %}
        {% assign time = daily.time[i] %}

        <div class="flex flex--row flex--center-y w--full gap--xlarge w--full
          {% if color_mode == 'light' %}
          text--black
          {% else %}
          text--white
          {% endif %}
          ">

          <div class="flex flex--col flex--left gap--xsmall w--full">
            <div class="day-name mb--1 lg:value--xsmall">{{ time | date: "%a" | downcase }}</div>
            <div class="flex gap--xsmall">
              <div class="forcast-digit lg:hidden" data-char="↑"></div>
              <div class="forcast-digit forcast-digit--large md:hidden lg:block" data-char="↑"></div>
              {% assign day_high_str = day_max | append: "" %}
              {% assign day_high_chars = day_high_str | split: "" %}
              {% for char in day_high_chars %}
              <div class="forcast-digit lg:hidden" data-char="{{ char }}"></div>
              <div class="forcast-digit forcast-digit--large md:hidden lg:block" data-char="{{ char }}"></div>
              {% endfor %}
              <div class="forcast-digit lg:hidden" data-char="°"></div>
              <div class="forcast-digit forcast-digit--large md:hidden lg:block" data-char="°"></div>
            </div>
            <div class="flex gap--xsmall">
              <div class="forcast-digit lg:hidden" data-char="↓"></div>
              <div class="forcast-digit forcast-digit--large md:hidden lg:block" data-char="↓"></div>
              {% assign day_low_str = day_min | append: "" %}
              {% assign day_low_chars = day_low_str | split: "" %}
              {% for char in day_low_chars %}
              <div class="forcast-digit lg:hidden" data-char="{{ char }}"></div>
              <div class="forcast-digit forcast-digit--large md:hidden lg:block" data-char="{{ char }}"></div>
              {% endfor %}
              <div class="forcast-digit lg:hidden" data-char="°"></div>
              <div class="forcast-digit forcast-digit--large md:hidden lg:block" data-char="°"></div>
            </div>
          </div>
          <div class="value lg:value--medium mt--5 text--center">
            {% render "wd_icon", code: daily.weather_code[i] %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <script>
    renderDigits({
      '.temp-digit': 65,
      '.temp-digit--large': 110,
      '.small-temp-digit': 31,
      '.small-temp-digit--large': 50,
      '.forcast-digit': 25,
      '.forcast-digit--large': 28
    });
  </script>

  {% endif %}